<!-- DevExtreme libraries -->
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.3/css/dx.light.css">
<script src="https://cdn3.devexpress.com/jslib/23.2.3/js/dx.all.js"></script>

<!-- Export libraries -->
<script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.0/jspdf.plugin.autotable.min.js"></script>
<script src="https://jsuites.net/v5/jsuites.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>


<script>       
    $(document).ready(function () {
        jSuites.calendar(document.getElementById('date'), {
            type: 'year-month-picker',
            format: 'MMMM-YYYY',
            today: true,
            validRange: [ '2025-01-01', ((new Date()).toISOString().substring(0, 10)) ]
        });
        loadData();
    });
        const fontbase64code = ``;

   const generateReport = async ({
        reportType,          // 'mdm', 'milk', or 'eggbanana'
        endpoint,            // e.g. '/api/reports/mdmreport'
        containerId,         // e.g. '#mdmreport'
        filenamePrefix,      // e.g. 'MDM Report'
        dataKey,             // e.g. 'mdmReport', 'milkReport', etc.
        dynamicColumns       // The specific columns for each report
    }) => {
        const data = {
            ngocode: sessionStorage.getItem('ngocode'),
            date: $("#date").val()
        };
    
        try {
            const response = await apiRequest('post', endpoint, data);
    
            if (response.data.success) {
                const result = response.data[dataKey];
                $(containerId).dxDataGrid({
                    dataSource: result,
                    showBorders: true,
                    paging: false,
                    wordWrapEnabled: true,
                    columnAutoWidth: true,
                    allowColumnResizing: true,
                    columns: [{
                        caption: "ಯುನೈಟೆಡ್ ಸಮಾಜ ಕಲ್ಯಾಣ ಸಂಸ್ಥೆ ಬೆಳಗಾವಿ",
                        columns: dynamicColumns
                    }],
                    export: {
                        enabled: true,
                        formats: ['pdf', 'xlsx'],
                    },
                    toolbar: {
                        items: ['exportButton', 'searchPanel']
                    },
                    onExporting: async function (e) {
                        if (e.format === 'xlsx') {
                            const workbook = new ExcelJS.Workbook();
                            const worksheet = workbook.addWorksheet(`${filenamePrefix}`);
                            await DevExpress.excelExporter.exportDataGrid({
                                component: e.component,
                                worksheet,
                                autoFilterEnabled: false,
                                keepColumnWidths: true,
                                customizeCell: function(options) {
                                    if (options.gridCell.rowType === "header") {
                                        console.log(options.excelCell);
                                        options.excelCell.style.alignment.vertical = "middle";
                                    }
                                    else{
                                        options.excelCell.style.bold = false;
                                    }
                                }
                            });
                            const buffer = await workbook.xlsx.writeBuffer();
                            saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), `${filenamePrefix}.xlsx`);
                        } else {
                            const { jsPDF } = window.jspdf;
                            const doc = new jsPDF({ orientation: "landscape", unit: "mm", format: "a3" });
    
                            doc.addFileToVFS('Tunga.ttf', fontbase64code);
                            doc.addFont('Tunga.ttf', 'Tunga', 'normal');
                            doc.setFont('Tunga');
    
                            await DevExpress.pdfExporter.exportDataGrid({
                                jsPDFDocument: doc,
                                component: e.component,
                                indent: 5,
                                customizeCell: function (options) {
                                    if (options.gridCell.rowType === "header") {
                                        options.pdfCell.alignment = "center";
                                        options.pdfCell.horizontalAlign = "center";
                                        options.pdfCell.backgroundColor = "aliceblue";
                                    }
                                },
                                keepColumnWidths: true,
                                autoFilterEnabled: true
                            });
                            doc.save(`${filenamePrefix}.pdf`);
                        }
                    }
                });
            }
        } catch (error) {
            if(error.error == 'jwt expired'){
                toastr.error(error.response?.statusText || "Error occurred");
                window.location.href = "/logout";
            }
            //toastr.error(error.response?.statusText || "Error occurred");
            //console.error(error.response?.data?.message || error.message);
        } finally {
            $('#loader').fadeOut();
        }
    };


     const loadData = async () => {
        $('#loader').fadeIn();
        //MDM Report
        generateReport({
            reportType: 'mdm',
            endpoint: '/api/reports/mdmreport',
            containerId: '#mdmreport',
            filenamePrefix: 'MDM Report',
            dataKey: 'mdmReport',
            dynamicColumns: [
                { dataField: "date", caption: "ದಿನಾಂಕ" },
                { dataField: "riceReceived", caption: "ಬಂದ ಅಕ್ಕಿಯ ವಿವರ" },
                { dataField: "openingBalance", caption: "ಆರಂಭದ ಶಿಲ್ಕು" },
                {
                    caption: "ಹಾಜರಾತಿ",
                    columns: [
                        { dataField: "g1totalpresent", caption: "1 ರಿಂದ 5" },
                        { dataField: "g2totalpresent", caption: "6 ರಿಂದ 7" },
                        { dataField: "g3totalpresent", caption: "8ನೇ ತರಗತಿ" },
                        { dataField: "g4totalpresent", caption: "9 ರಿಂದ 10" },
                        { dataField: "sumoftotalpresent", caption: "ಒಟ್ಟು 1 ರಿಂದ 10" }
                    ]
