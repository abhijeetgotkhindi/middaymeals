                        { dataField: "g2hotmeals", caption: "6 ರಿಂದ 7" },
                        { dataField: "g3hotmeals", caption: "8ನೇ ತರಗತಿ" },
                        { dataField: "g4hotmeals", caption: "9 ರಿಂದ 10" },
                        { dataField: "sumoftotalhotmeals", caption: "ಒಟ್ಟು 1 ರಿಂದ 10" }
                    ]
                }
            ]
        });
        //Milk Report
        generateReport({
            reportType: 'milk',
            endpoint: '/api/reports/milkreport',
            containerId: '#milkreport',
            filenamePrefix: 'Milk Report',
            dataKey: 'milkReport',
            dynamicColumns: [
                { dataField: "date", caption: "ದಿನಾಂಕ" },
                { dataField: "riceReceived", caption: "ಬಂದ ಅಕ್ಕಿಯ ವಿವರ" },
                { dataField: "openingBalance", caption: "ಆರಂಭದ ಶಿಲ್ಕು" },
                {
                    caption: "ಹಾಜರಾತಿ",
                    columns: [
                        { dataField: "g1totalpresent", caption: "1 ರಿಂದ 5" },
                        { dataField: "g2totalpresent", caption: "6 ರಿಂದ 7" },
                        { dataField: "g3totalpresent", caption: "8ನೇ ತರಗತಿ" },
                        { dataField: "g4totalpresent", caption: "9 ರಿಂದ 10" },
                        { dataField: "sumoftotalpresent", caption: "ಒಟ್ಟು 1 ರಿಂದ 10" }
                    ]
                },
                {
                    caption: "ಹಾಲು ಪಡೆಯುತ್ತಿರುವ ಮಕ್ಕಳ ಸಂಖ್ಯೆ",
                    columns: [
                        { dataField: "g1milk", caption: "1 ರಿಂದ 5" },
                        { dataField: "g2milk", caption: "6 ರಿಂದ 7" },
                        { dataField: "g3milk", caption: "8ನೇ ತರಗತಿ" },
                        { dataField: "g4milk", caption: "9 ರಿಂದ 10" },
                        { dataField: "sumoftotalmilk", caption: "ಒಟ್ಟು 1 ರಿಂದ 10" }
                    ]
                }
            ]
        });
    //EGG & Banana Report
        generateReport({
            reportType: 'eggbanana',
            endpoint: '/api/reports/eggbananareport',
            containerId: '#eggbananareport',
            filenamePrefix: 'Egg & Banana Report',
            dataKey: 'eggBananaReport',
            dynamicColumns: [
                { dataField: "date", caption: "ದಿನಾಂಕ" },
                { dataField: "riceReceived", caption: "ಬಂದ ಅಕ್ಕಿಯ ವಿವರ" },
                { dataField: "openingBalance", caption: "ಆರಂಭದ ಶಿಲ್ಕು" },
                {
                    caption: "ಹಾಜರಾತಿ",
                    columns: [
                        { dataField: "g1totalpresent", caption: "1 ರಿಂದ 5" },
                        { dataField: "g2totalpresent", caption: "6 ರಿಂದ 7" },
                        { dataField: "g3totalpresent", caption: "8ನೇ ತರಗತಿ" },
                        { dataField: "g4totalpresent", caption: "9 ರಿಂದ 10" },
                        { dataField: "sumoftotalpresent", caption: "ಒಟ್ಟು 1 ರಿಂದ 10" }
                    ]
                },
                {
                    caption: "ಮೊಟ್ಟೆ ಪಡೆದ ಮಕ್ಕಳ ಸಂಖ್ಯೆ",
                    columns: [
                        { dataField: "g1egg", caption: "1 ರಿಂದ 5" },
                        { dataField: "g2egg", caption: "6 ರಿಂದ 7" },
                        { dataField: "g3egg", caption: "8ನೇ ತರಗತಿ" },
                        { dataField: "g4egg", caption: "9 ರಿಂದ 10" },
                        { dataField: "sumoftotalegg", caption: "ಒಟ್ಟು 1 ರಿಂದ 10" }
                    ]
                },
                {
                    caption: "ಬಾಳೆಹಣ್ಣು ಪಡೆದ ಮಕ್ಕಳ ಸಂಖ್ಯೆ",
                    columns: [
                        { dataField: "g1banana", caption: "1 ರಿಂದ 5" },
                        { dataField: "g2banana", caption: "6 ರಿಂದ 7" },
                        { dataField: "g3banana", caption: "8ನೇ ತರಗತಿ" },
                        { dataField: "g4banana", caption: "9 ರಿಂದ 10" },
                        { dataField: "sumoftotalbanana", caption: "ಒಟ್ಟು 1 ರಿಂದ 10" }
                    ]
                }
            ]
        });

        $('#loader').fadeOut();    
        };
</script>
